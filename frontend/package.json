{
  "name": "twinkletune",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/audio-engine",
    "apps/game",
    "apps/audio-lab"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/game",
    "dev:lab": "npm run dev -w apps/audio-lab",
    "dev:marketing": "vite --host 127.0.0.1 --port 4175 --strictPort ../marketing",
    "build": "npm run build -w apps/game",
    "build:lab": "npm run build -w apps/audio-lab",
    "preview": "npm run preview -w apps/game",
    "test": "npm test -ws --if-present",
    "test:watch": "npm run test:watch -w apps/game"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
