<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>TwinkleTune.Cli</RootNamespace>
    <AssemblyName>twinkletune</AssemblyName>

    <!-- Installable global tool: dotnet tool install --global TwinkleTune.Cli -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>twinkletune</ToolCommandName>
    <PackageId>TwinkleTune.Cli</PackageId>
    <Version>1.0.0</Version>
    <Authors>TwinkleTune</Authors>
    <Description>Admin CLI for the TwinkleTune family karaoke server: seed the database and manage songs and avatars.</Description>
    <PackageTags>twinkletune;cli;dotnet-tool;karaoke</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TwinkleTune.Infrastructure\TwinkleTune.Infrastructure.csproj" />
  </ItemGroup>
</Project>
