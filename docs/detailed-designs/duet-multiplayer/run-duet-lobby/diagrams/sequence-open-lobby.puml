@startuml
title UML sequence behaviour — Open the lobby and pick a song
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Singer (host device)" as singer
box "Frontend — TwinkleTune web app (host device)" #E0F2FE
  participant "renderDuet" as screen
  participant "loadSongs()" as repo
  participant "showLobby" as lobby
  participant "DuetClient" as client
end box
box "Backend — TwinkleTune API application" #D1FADF
  participant "DuetHub" as hub
end box
box "Backend — TwinkleTune Application and Domain" #ECFDF3
  participant "RoomService" as service
end box

singer -> screen : Open #/duet?song=twinkle
alt profile has no singerId
  screen --> singer : "Duets need a family profile" with "Pick my profile" to #/profiles (DM-L2-13)
else profile is server-linked
  screen -> repo : loadSongs()
  repo --> screen : { songs, online }
  alt online == false
    screen --> singer : "Duets need the family server" with "Sing solo instead" to #/songs (DM-L2-13)
  else online == true
    screen --> singer : Show "Make a room" and "Join with a code" (DM-L2-12)
    singer -> screen : Tap "Make a room"
    screen -> client : createRoom(me)
    client -> hub : invoke CreateRoom(info)
    hub -> service : Create(connectionId, info)
    service --> hub : RoomStateDto
    hub --> client : RoomStateDto
    alt connection or create fails
      client --> screen : rejected promise
      screen --> singer : Toast "Can't reach the family server" and stay on the duet screen (DM-L2-16)
    else room returned
      client --> lobby : RoomState
      lobby -> lobby : duetSession.set(client, code, me, opponent)
      lobby --> singer : Room code painted one letter per span, waiting placeholder shown (DM-L2-12)
      hub -> lobby : PlayerJoined(info) when the second singer arrives
      lobby --> singer : Toast "<name> is here!" and repaint with both players (DM-L2-12)
      lobby --> singer : Song picker with the entry-link song pre-selected, plus "Start the duet!" (DM-L2-12)
      singer -> lobby : Tap "Start the duet!"
      lobby -> client : startSong(songId)
      client -> hub : invoke StartSong(songId)
      alt start refused
        hub --> client : HubException "You need two singers in the room to start!"
        client --> lobby : rejected promise
        lobby --> singer : Toast "Need both singers in the room!" and stay in the lobby (DM-L2-16)
      else start accepted
        hub --> client : SongStarted broadcast to the group
        client --> lobby : Hand off to the singing screen
      end
    end
  end
end
@enduml
