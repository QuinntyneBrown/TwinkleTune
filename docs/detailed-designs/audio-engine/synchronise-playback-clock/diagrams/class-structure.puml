@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Synchronise playback clock

class SongPlayer {
  +playing: boolean
  -nodes: AudioNode[]
  -doneTimer: timeout handle
  -t0: number
  -spb: number
  -startBeat: number
  -countIn: number
  +start(song: Song, opts: PlayOptions): void
  +currentBeat(): number
  +secondsPerBeat(): number
  +stop(): void
}

interface PlayOptions {
  +fromBeat?: number
  +countInBeats?: number
  +onDone?: () => void
}

class "player.ts" as PlayerMod <<module>> {
  +audioCtx(): AudioContext
}

class "latency.ts" as LatencyMod <<module>> {
  +MAX_DEVICE_LATENCY_MS: number = 500
  +pipelineLatencyMs(report: LatencyReport): number
}

interface LatencyReport {
  +baseLatency?: number
  +outputLatency?: number
  +inputLatency?: number
  +sampleRate: number
  +windowSize: number
}

class PitchTracker <<pitch.ts>> {
  -inputLatency: number?
  +pipelineLatencyMs(): number
}

SongPlayer ..> PlayOptions : reads onDone
SongPlayer ..> PlayerMod : reads currentTime
LatencyMod ..> LatencyReport : sums and bounds
PitchTracker ..> LatencyMod : pipelineLatencyMs(report)
PitchTracker ..> PlayerMod : reads baseLatency, outputLatency, sampleRate
@enduml
