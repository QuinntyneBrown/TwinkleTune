@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Detect pitch

class PitchTracker {
  +latest: PitchFrame?
  -media: MediaStream?
  -source: MediaStreamAudioSourceNode?
  -analyser: AnalyserNode?
  -buf: Float32Array
  -analyzer: PitchAnalyzer
  +running: boolean
  +start(): Promise<void>
  +read(): PitchFrame?
  +pipelineLatencyMs(): number
  +stop(): void
}

class PitchAnalyzer {
  +windowSize: number
  -band: BandLimiter
  -filtered: Float32Array
  -detector: PitchDetector
  -history: number[]
  +analyze(buf: Float32Array, sampleRate: number): PitchFrame?
  +reset(): void
}

class BandLimiter <<band-limit.ts>> {
  +lowHz: number
  +highHz: number
  +process(input: Float32Array, sampleRate: number, output: Float32Array): void
}

interface PitchFrame {
  +hz: number
  +midi: number
  +clarity: number
  +rms: number
}

class "PitchDetector" as Detector <<pitchy>> {
  +forFloat32Array(size: number): PitchDetector
  +findPitch(buf, sampleRate): [number, number]
}

class "range.ts" as RangeMod <<module>> {
  +hzToMidi(hz: number): number
}

PitchTracker --> "0..1" PitchFrame : latest
PitchTracker *-- "1" PitchAnalyzer : delegates each window
PitchAnalyzer *-- "1" BandLimiter : band-limits 90-1500 Hz
PitchAnalyzer ..> PitchFrame : produces
PitchAnalyzer ..> Detector : findPitch
PitchAnalyzer ..> RangeMod : hzToMidi
@enduml
