@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure - Capture and score notes

class "renderSing (Sing! screen)" as Sing <<module>> {
  -judge: NoteJudge
  -landedCount: number
  -streak: number
  -scoreBeat(beat): number
  -toleranceBeats(): number
  -loop(): void
  -finalizeNotesUpTo(beat: number, toleranceBeats: number): void
}

class NoteJudge {
  +results: NoteResult[]
  +finalizedCount: number
  +activeIndex(scoreBeat: number): number
  +observe(scoreBeat: number, sungMidi: number | null, toleranceBeats: number, frameMs: number): Observation
  +observeHops(scoreBeat: number, hops: HopObservation[], timing: HopTiming): Observation | null
  +finalize(scoreBeat: number, toleranceBeats: number): number[]
  +reset(): void
}

interface Observation {
  +activeIdx: number
  +onNote: boolean
}

interface JudgeNote {
  +midi: number
  +start: number
  +dur: number
  +phraseIdx: number
  +noteIdx: number
}

interface NoteResult {
  +phraseIdx: number
  +noteIdx: number
  +midi: number
  +hitMs: number
  +voicedMs: number
  +totalMs: number
  +firstHitFrac: number | null
}

class "scoring" as Scoring <<module>> {
  +HIT_TOLERANCE_CENTS = 50
  +hitToleranceCents(strictness): number
  +foldCents(sung, target): number
  +noteLanded(r: NoteResult): boolean
}

class "note-judge" as JudgeMod <<module>> {
  +TIMING_TOLERANCE_MS = 180
  +MAX_FRAME_MS = 40
}

class PitchTracker <<audio engine>> {
  +readHops(): PitchObservation[]
  +pipelineLatencyMs(): number
}

class DuetClient {
  +sendTick(tick: DuetTick): void
}

interface DuetTick {
  +landed: number
  +streak: number
  +sparkles: number
  +noteIdx: number
}

Sing "1" *-- "1" NoteJudge : drives one frame per tick
NoteJudge "1" *-- "*" NoteResult : owns tallies
NoteJudge --> "*" JudgeNote : judges against
NoteJudge ..> Observation : returns
NoteJudge ..> Scoring : foldCents / noteLanded
Sing ..> JudgeMod : TIMING_TOLERANCE_MS
Sing ..> Scoring : noteLanded
Sing ..> PitchTracker : readHops / pipelineLatencyMs per frame
Sing ..> DuetClient : sendTick per note
DuetClient ..> DuetTick : sends
@enduml
