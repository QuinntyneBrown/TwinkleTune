@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Capture and score notes

Container_Boundary(web, "TwinkleTune web app") {
  Component(loop, "renderSing render loop", "TypeScript module", "Computes scoreBeat and the timing tolerance; feeds one frame per tick")
  Component(judge, "NoteJudge", "TypeScript class", "Selects the active note; attributes each sung frame to it or to a neighbour within 180 ms; settles notes in order")
  Component(results, "NoteResult tallies", "TypeScript state", "hitMs, voicedMs, totalMs, firstHitFrac per note")
  Component(scoring, "scoring helpers", "TypeScript module", "foldCents, hitToleranceCents, noteLanded")
  Component(finalize, "finalizeNotesUpTo", "TypeScript function", "Applies landed / missed; updates streak and sparkles")
  Component(duet, "DuetClient", "SignalR wrapper", "sendTick(DuetTick) per finalised note")
}
System_Ext(mic, "Browser microphone and Web Audio", "Pitch source")
System_Ext(hub, "Family Server - Duet relay", "SignalR hub (Duet Multiplayer)")

Rel(loop, mic, "Reads pitch frames", "Web Audio API")
Rel(loop, judge, "observe(scoreBeat, sungMidi, toleranceBeats, frameMs)")
Rel(judge, scoring, "foldCents within the singer's hit tolerance; noteLanded")
Rel(judge, results, "Adds frame time to totalMs / voicedMs / hitMs; records firstHitFrac")
Rel(finalize, judge, "finalize(scoreBeat, toleranceBeats)")
Rel(finalize, results, "Reads tallies")
Rel(finalize, scoring, "noteLanded(r)")
Rel(finalize, duet, "sendTick per finalised note")
Rel(duet, hub, "ScoreTick", "SignalR/WSS")
@enduml
