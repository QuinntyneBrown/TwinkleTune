@startuml
title UML sequence - Accumulate then finalise a note (capture and score notes)
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Child" as child
box "Frontend - TwinkleTune web app" #E0F2FE
  participant "renderSing loop()" as rloop
  participant "PitchTracker" as tracker
  participant "NoteJudge" as judge
  participant "scoring helpers" as scoring
  participant "NoteResult tallies" as results
  participant "finalizeNotesUpTo" as finalize
  participant "DuetClient" as duet
end box
box "Backend - Family Server (Duet relay)" #D1FADF
  participant "Duet relay hub" as hub
end box

child -> rloop : requestAnimationFrame tick
rloop -> tracker : pipelineLatencyMs() per AE-L2-18
tracker --> rloop : output + input + analysis delay
rloop -> rloop : scoreBeat = beat - (estimate + profile offset) in beats per SG-L2-19
rloop -> rloop : toleranceBeats = 180 ms / secondsPerBeat per SG-L2-25
rloop -> tracker : readHops() per AE-L2-21
tracker --> rloop : observations { frame, ageMs }, one per 1/60 s hop, oldest first
rloop -> judge : observeHops(scoreBeat, hops, { toleranceBeats, secondsPerBeat, hopMs }) per SG-L2-26
note over judge : for each observation:\nobserve(scoreBeat - age in beats, sungMidi, toleranceBeats, hopMs)
judge -> judge : t = min(hopMs, 40 ms) per SG-L2-9
opt active note present
  judge -> results : active.totalMs += t per SG-L2-9
end
opt pitch detected
  judge -> scoring : foldCents(sungMidi, note.midi + shift)
  scoring --> judge : cents
  alt on-pitch for the active note
    judge -> results : active.voicedMs += t, hitMs += t; firstHitFrac on first hit
  else on-pitch for a neighbour within the tolerance per SG-L2-25
    judge -> results : neighbour.voicedMs += t, hitMs += t (if not yet finalised)
  else matches no nearby note
    judge -> results : active.voicedMs += t (sung, off-pitch)
  end
end
judge --> rloop : { activeIdx, onNote } of the newest observation, or null if none
rloop -> finalize : finalizeNotesUpTo(scoreBeat, toleranceBeats)
finalize -> judge : finalize(scoreBeat, toleranceBeats)
judge -> scoring : noteLanded(r) — a landed note settles at its end
judge --> finalize : indices settled (others wait out the tolerance) per SG-L2-10
finalize -> scoring : noteLanded(r)
alt landed per SG-L2-10
  scoring --> finalize : true
  finalize -> finalize : landedCount++; streak+1; pill .hit; cheer; sparkles = landedCount*10
else missed per SG-L2-10
  scoring --> finalize : false
  finalize -> finalize : setStreak(0); no negative message
end
finalize -> duet : sendTick({landed, streak, sparkles, noteIdx}) per SG-L2-22
duet -> hub : ScoreTick (errors swallowed)
finalize --> child : cheers and sparkle count in time
@enduml
