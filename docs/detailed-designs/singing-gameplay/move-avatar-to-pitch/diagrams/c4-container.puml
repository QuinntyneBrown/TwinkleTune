@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Move the avatar to the child's pitch

Person(child, "Child", "Sings into the tablet")
System_Boundary(tt, "TwinkleTune") {
  Container(web, "TwinkleTune web app", "TypeScript, plain DOM modules", "Reads pitch and positions the star on-device")
}
System_Ext(mic, "Browser microphone and Web Audio", "getUserMedia / Web Audio API")

Rel(child, web, "Sings; watches the star move", "Voice / touch")
Rel(web, mic, "Reads a pitch frame each animation frame", "Web Audio API")
@enduml
