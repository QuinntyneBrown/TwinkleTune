@startuml
title UML sequence behaviour — Judge one note across its frames
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Singer" as singer
box "Frontend — TwinkleTune web app" #E0F2FE
  participant "renderSing loop (sing.ts)" as loop
  participant "PitchTracker (pitch.ts)" as tracker
  participant "NoteJudge (note-judge.ts)" as judge
  participant "NoteResult" as result
  participant "scoring.ts rules" as rules
end box
box "Device — Browser Web Audio & microphone" #FFF4E5
  participant "AnalyserNode" as mic
end box

singer -> loop : Sings while the note is active
loop -> tracker : read()
tracker -> mic : getFloatTimeDomainData
mic --> tracker : time-domain samples
tracker --> loop : PitchFrame { midi } or null

loop -> judge : observe(scoreBeat, sungMidi, toleranceBeats, frameMs)
judge -> judge : t = min(frameMs, 40 ms)
judge -> result : totalMs += t
alt pitch detected
  judge -> rules : foldCents(sungMidi, n.midi + shift) (SR-L2-1)
  rules --> judge : signed cents in (-600, +600]
  alt |cents| <= the singer's hit tolerance: 80, 65 or 50 (SR-L2-20)
    judge -> result : voicedMs += t, hitMs += t
    opt firstHitFrac is null
      judge -> result : firstHitFrac = (scoreBeat - n.start) / n.dur
    end
    judge --> loop : onNote = true
    loop --> singer : Star moves to the note and glows
  else outside the tolerance band
    judge -> result : voicedMs += t (sung, off-pitch)
    judge --> loop : onNote = false
  end
else no pitch this frame
  judge --> loop : onNote = false
  loop --> singer : Star drifts to centre; silence is not held against the note (SR-L2-2)
end

loop -> judge : finalize(scoreBeat, toleranceBeats) once the note is settled
judge --> loop : settled note index
loop -> rules : noteLanded(result) (SR-L2-2)
alt hitMs < 45
  rules --> loop : false — minimum-sample guard (SR-L2-2)
else hitMs < 0.5 * voicedMs
  rules --> loop : false — precision: mostly off-pitch while singing (SR-L2-2)
else hitMs < 0.25 * totalMs
  rules --> loop : false — coverage: a passing blip (SR-L2-2)
else all three rules pass
  rules --> loop : true — note landed (SR-L2-2)
  loop --> singer : Streak advances and sparkles rise
end
@enduml
