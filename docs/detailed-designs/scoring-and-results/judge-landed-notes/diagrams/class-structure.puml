@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Judge landed notes

interface NoteResult {
  +phraseIdx: number
  +noteIdx: number
  +midi: number
  +hitMs: number
  +voicedMs: number
  +totalMs: number
  +firstHitFrac: number?
}

class "scoring.ts" as ScoringMod <<module>> {
  +HIT_TOLERANCE_CENTS: number = 50
  +pitchStrictness(value: unknown): PitchStrictness
  +hitToleranceCents(value: unknown): number
  +MIN_HIT_MS: number = 45
  +MIN_PRECISION: number = 0.5
  +MIN_COVERAGE: number = 0.25
  +foldCents(sungMidi: number, targetMidi: number): number
  +noteLanded(r: NoteResult): boolean
  +summarize(song: Song, results: NoteResult[], noMic: boolean): SongSummary
}

class NoteJudge {
  +results: NoteResult[]
  +finalizedCount: number
  +activeIndex(scoreBeat: number): number
  +observe(scoreBeat: number, sungMidi: number?, toleranceBeats: number, frameMs: number): Observation
  +finalize(scoreBeat: number, toleranceBeats: number): number[]
  +reset(): void
}

class "sing.ts" as SingMod <<module>> {
  +renderSing(root: HTMLElement, params: URLSearchParams): () => void
  -finalizeNotesUpTo(beat: number, toleranceBeats: number): void
}

interface JudgeNote {
  +midi: number
  +start: number
  +dur: number
  +phraseIdx: number
  +noteIdx: number
}

class PitchFrame <<audio engine>> {
  +hz: number
  +midi: number
  +clarity: number
  +rms: number
}

ScoringMod ..> NoteResult : folds and judges
NoteJudge --> "*" NoteResult : accumulates one per note
NoteJudge --> "*" JudgeNote : judges against
NoteJudge ..> ScoringMod : foldCents / noteLanded
SingMod --> "1" NoteJudge : feeds one frame per tick
SingMod ..> PitchFrame : reads sung midi
SingMod ..> ScoringMod : noteLanded / summarize
@enduml
