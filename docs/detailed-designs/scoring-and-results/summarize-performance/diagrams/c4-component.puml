@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Summarize a performance (scoring.ts)

Container_Boundary(scoring, "Scoring rules (scoring.ts)") {
  Component(summarize, "summarize()", "TypeScript function", "Reduces NoteResult[] and Song to a SongSummary")
  Component(landed, "noteLanded()", "TypeScript function", "Produces the landedFlags array")
  Component(stars, "starsFromRatio()", "TypeScript function", "Two-threshold 3/2/1 mark")
  Component(summary, "SongSummary", "TypeScript interface", "accuracy, stars, dimension marks, streak, sparkles")
}
Container_Boundary(songs, "Song model (songs/types.ts)") {
  Component(range, "songRange()", "TypeScript function", "Lowest and highest MIDI note of the song")
}
Container_Boundary(state, "App state (store.ts)") {
  Component(record, "recordPlay()", "TypeScript function", "Writes lastResult and lastNewBadges")
}

Rel(summarize, landed, "noteLanded(r) per note")
Rel(summarize, stars, "accuracy (0.85 / 0.6); timing (0.8 / 0.5); braveness (0.9 / 0.6)")
Rel(summarize, range, "songRange(song).max for high notes within 2 semitones")
Rel(summarize, summary, "Returns")
Rel(record, summary, "Stores as lastResult")
@enduml
