@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Own data across device and server

Container_Boundary(device, "TwinkleTune web app on one device") {
  Component(state, "AppState", "TypeScript interface", "sparkles, singDays, plays, bests, badges — never sent to the server")
  Component(prof, "Profile", "TypeScript interface", "name, avatar, range, latencyMs (device property), singerId")
  Component(keys, "profileKey / ACTIVE_KEY", "Storage keys", "Per-singer namespacing on a shared device")
  Component(bridge, "profile.ts", "Bridge module", "applySingerToProfile, activateSinger, pushProfileToServer")
  ComponentDb(local, "localStorage", "Browser storage", "Device-owned blobs")
}
Container_Boundary(server, "TwinkleTune family server") {
  Component(singer, "Singer", "Domain entity", "RangeLow and RangeHigh — the person property")
  Component(avatar, "Avatar", "Domain entity", "Emoji and name")
  Component(song, "Song", "Domain entity", "Note data owned by the family")
  Component(score, "HighScore", "Domain entity", "One best per singer and song")
  ComponentDb(db, "twinkletune.db", "SQLite file", "The server-owned records")
}

Rel(state, local, "Persisted under the active key (FS-L2-16)")
Rel(prof, keys, "Bound to a singer by singerId (FS-L2-16)")
Rel(bridge, prof, "Merges server fields, preserving latencyMs (FS-L2-16)")
Rel(bridge, singer, "Reads and writes the range (FS-L2-16)", "JSON/HTTP")
Rel(singer, avatar, "References")
Rel(score, singer, "Belongs to")
Rel(score, song, "Belongs to")
Rel(singer, db, "Persisted in")
Rel(song, db, "Persisted in")
Rel(score, db, "Persisted in")
@enduml
