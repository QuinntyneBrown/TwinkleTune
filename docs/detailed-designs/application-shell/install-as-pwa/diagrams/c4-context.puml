@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Install as a PWA

Person(grownup, "Grown-up", "Sets the app up on the child's tablet")
Person(child, "Young singer", "Taps the home-screen icon to sing")
System(twinkle, "TwinkleTune web app", "Ships a web manifest and relative assets so it installs as a home-screen app")
System_Ext(browser, "Browser install machinery", "Reads the manifest, offers Add to Home Screen, launches the installed app")
System_Ext(host, "Static host", "Serves index.html, the manifest, the icons, and the bundle from any directory")

Rel(grownup, browser, "Chooses Add to Home Screen")
Rel(browser, twinkle, "Fetches ./manifest.webmanifest and the icons")
Rel(twinkle, browser, "Declares name, standalone display, portrait orientation, colours, and icons")
Rel(browser, child, "Launches TwinkleTune full-screen from the home-screen icon")
Rel(host, twinkle, "Serves the built app from a root or a sub-path")
@enduml
