@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Manage server singers

Person(grownup, "Grown-up", "Adds and edits the family's singers")
System(twinkle, "TwinkleTune web app", "Singer dialog on the profiles screen (TypeScript)")
System(family, "Family server", "Self-hosted .NET API owning the durable singer record")

