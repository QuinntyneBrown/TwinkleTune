@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Disclose data handling

Person(grownup, "Grown-up", "Reads the disclosure before using any control")
System(twinkle, "TwinkleTune web app", "On-device singing app; states the data split in the Grown-Ups Corner (TypeScript)")
System_Ext(storage, "Browser localStorage", "Sparkles, badges, streaks and the device profile")
System_Ext(server, "Family server", "Home-LAN server holding profiles, songs, avatars and family high scores")
