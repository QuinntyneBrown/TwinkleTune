@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Calibrate mic latency

Container_Boundary(hub, "Grown-Ups Corner hub (settings.ts)") {
  Component(slider, "[data-latency] range input", "HTML input", "min=-300, max=300, step=10, value=profile.latencyMs")
  Component(label, "[data-latency-label]", "HTML element", "Renders the value with a ' ms' suffix")
  Component(handler, "slider input handler", "TypeScript listener", "Updates the label then calls store.update")
}
Container_Boundary(state, "State and consumers") {
  Component(store, "store.update(fn)", "state/store.ts", "Mutates AppState then serializes it")
  ComponentDb(local, "localStorage blob", "Browser storage", "twinkletune:v1[:singerId]")
  Component(merge, "applySingerToProfile()", "state/profile.ts", "Carries latency across as prev.latencyMs ?? 0")
  Component(loop, "Sing frame loop", "screens/sing.ts", "scoreBeat = beat - (latencyMs / 1000) / secondsPerBeat()")
}

Rel(slider, handler, "input event on each 10 ms step")
Rel(handler, label, "Set textContent to `${value} ms`")
Rel(handler, store, "profile.latencyMs = Number(slider.value)")
Rel(store, local, "setItem(key, JSON.stringify(state))")
Rel(merge, store, "Rebuilds the profile without discarding latency")
Rel(loop, store, "store.get().profile.latencyMs")
@enduml
