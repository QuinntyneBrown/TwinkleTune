@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Calibrate mic latency

Person(grownup, "Grown-up", "Adjusts the offset")
System_Boundary(twinkle, "TwinkleTune web app") {
  Container(hub, "Grown-Ups Corner hub", "TypeScript (settings.ts)", "Latency slider and numeric read-out")
  Container(state, "App store", "TypeScript (state/store.ts)", "AppState with the active Profile")
  Container(sing, "Sing screen", "TypeScript (screens/sing.ts)", "Frame loop applying latency compensation")
  Container(sync, "Profile sync", "TypeScript (state/profile.ts)", "Merges the server singer into the local profile")
  ContainerDb(local, "Device profile store", "localStorage", "twinkletune:v1[:singerId] blob")
}
System_Ext(api, "Family server API", "/api/singers endpoints")

Rel(grownup, hub, "Drags the -300..+300 ms slider", "10 ms steps")
Rel(hub, state, "store.update(profile.latencyMs = value)")
Rel(state, local, "Serializes AppState on every update")
Rel(sing, state, "Reads profile.latencyMs each frame")
Rel(sync, state, "Rebuilds the profile, preserving prev.latencyMs")
Rel(sync, api, "PUT /api/singers/{id} without a latency field", "JSON/HTTPS")
@enduml
