@startuml
title UML sequence behaviour — Update a song best after a play
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Singer" as singer
box "Frontend — TwinkleTune web app" #E0F2FE
  participant "Sing screen" as sing
  participant "recordPlay()" as record
  participant "Reward store" as store
  participant "Home dashboard" as home
end box
box "Device — Browser storage" #FFF4E5
  database "localStorage" as ls
end box

singer -> sing : Finish a run of the song
sing -> record : recordPlay(store, song, summary, today)
record -> store : update(state => ...)
record -> record : best = bests[song.id] ?? { stars: 0, accuracy: 0, plays: 0 }

alt scored run (noMic false)
  record -> record : stars = max(best.stars, summary.stars) (RP-L2-5)
  record -> record : accuracy = max(best.accuracy, summary.accuracy) (RP-L2-5)
else no-mic run
  record -> record : stars = max(best.stars, 0); accuracy = max(best.accuracy, 0) (RP-L2-5)
end
record -> record : plays = best.plays + 1 (RP-L2-5)
record -> store : bests[song.id] = updated SongBest
store -> ls : setItem(key, JSON state)
ls --> store : stored
store --> record : state saved
record --> sing : newly earned badge ids

singer -> home : Open the home screen
home -> store : get()
store --> home : AppState
home -> home : masteredCount = bests with stars > 0 (RP-L2-10)
alt masteredCount == 1
  home --> singer : "1 song mastered" (RP-L2-10)
else masteredCount != 1
  home --> singer : "{masteredCount} songs mastered" (RP-L2-10)
end
@enduml
