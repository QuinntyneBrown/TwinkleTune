@startuml
title UML sequence behaviour — Evaluate the badge rules for a completed play
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Singer" as singer
box "Frontend — TwinkleTune web app" #E0F2FE
  participant "Sing screen" as sing
  participant "recordPlay()" as record
  participant "evaluateBadges()" as evaluate
  participant "award(id, ok) guard" as award
  participant "Reward store" as store
end box
box "Device — Browser storage" #FFF4E5
  database "localStorage" as ls
end box

singer -> sing : Finish the song
sing -> record : recordPlay(store, song, summary, today)
record -> record : totalPlays = sum of bests[].plays
record -> record : streak = streakCount(singDays, today)
record -> evaluate : { totalPlays, streak, summary, songDifficulty, earned = keys(badges) }
evaluate -> evaluate : scored = !summary.noMic && summary.total > 0 (RP-L2-7)

evaluate -> award : first-song when totalPlays >= 1 (RP-L2-6)
evaluate -> award : streak-3 when streak >= 3 (RP-L2-6)
evaluate -> award : brave-bird when songDifficulty == 3 (RP-L2-6)
alt scored run
  evaluate -> award : high-note-hero when braveStars == 3 and accuracy >= 0.5 (RP-L2-6)
  evaluate -> award : show-stopper when stars == 3 (RP-L2-6)
  evaluate -> award : perfect-ten when maxStreak >= 10 (RP-L2-6)
else no-mic run
  evaluate -> evaluate : the three performance rules evaluate false (RP-L2-7)
end
award -> award : keep only ids absent from earned (RP-L2-7)
award --> evaluate : fresh ids
evaluate --> record : newly earned badge ids

record -> store : badges[id] = today for each new id; lastNewBadges = ids
store -> ls : setItem(key, JSON state)
ls --> store : stored
store --> record : state saved
record --> sing : newly earned badge ids
sing --> singer : Results screen celebrates each new badge once
@enduml
